{
  "titolo": "Palestra",
  "sottotitolo": "Esercizi senza scena: scrivi il codice, i test nascosti lo mettono alla prova.",
  "esercizi": [
    { "id": "p1", "titolo": "Il doppio", "capitolo": "Logica", "sintassi": ["call", "let", "if"], "consegna": "C'è già una variabile n. Scrivi nella console il doppio di n con console.log.", "starter": "console.log(n * 2)\n", "esempio": { "n": 3 }, "casi": [ { "variabili": { "n": 3 }, "atteso": ["6"] }, { "variabili": { "n": 10 }, "atteso": ["20"] }, { "variabili": { "n": 0 }, "atteso": ["0"] } ] },
    { "id": "p2", "titolo": "Pari o dispari", "capitolo": "Logica", "sintassi": ["call", "let", "if"], "consegna": "Scrivi \"pari\" se n è pari, \"dispari\" se è dispari. Il resto della divisione si calcola con n % 2.", "starter": "if (n % 2 === 0) {\n  \n} else {\n  \n}\n", "esempio": { "n": 4 }, "casi": [ { "variabili": { "n": 4 }, "atteso": ["pari"] }, { "variabili": { "n": 7 }, "atteso": ["dispari"] }, { "variabili": { "n": 0 }, "atteso": ["pari"] } ] },
    { "id": "p3", "titolo": "Il più grande", "capitolo": "Logica", "sintassi": ["call", "let", "if"], "consegna": "Ci sono due variabili, a e b. Scrivi nella console la più grande delle due.", "starter": "", "esempio": { "a": 3, "b": 8 }, "casi": [ { "variabili": { "a": 3, "b": 8 }, "atteso": ["8"] }, { "variabili": { "a": 12, "b": 5 }, "atteso": ["12"] }, { "variabili": { "a": -1, "b": -4 }, "atteso": ["-1"] } ] },
    { "id": "p4", "titolo": "Conta fino a n", "capitolo": "Cicli", "sintassi": ["call", "let", "if", "for"], "consegna": "Scrivi nella console i numeri da 1 a n, uno per riga.", "starter": "for (let i = 1; i <= n; i++) {\n  \n}\n", "esempio": { "n": 3 }, "casi": [ { "variabili": { "n": 3 }, "atteso": ["1", "2", "3"] }, { "variabili": { "n": 5 }, "atteso": ["1", "2", "3", "4", "5"] }, { "variabili": { "n": 1 }, "atteso": ["1"] } ] },
    { "id": "p5", "titolo": "La somma", "capitolo": "Cicli", "sintassi": ["call", "let", "if", "for", "while"], "consegna": "Somma tutti i numeri da 1 a n e scrivi il risultato. Ti serve una variabile che parte da 0 e cresce a ogni giro.", "starter": "let somma = 0\n", "esempio": { "n": 4 }, "casi": [ { "variabili": { "n": 4 }, "atteso": ["10"] }, { "variabili": { "n": 1 }, "atteso": ["1"] }, { "variabili": { "n": 10 }, "atteso": ["55"] } ] },
    { "id": "p6", "titolo": "Alla rovescia", "capitolo": "Cicli", "sintassi": ["call", "let", "if", "for", "while"], "consegna": "Scrivi i numeri da n fino a 1, poi la parola \"via\".", "starter": "", "esempio": { "n": 3 }, "casi": [ { "variabili": { "n": 3 }, "atteso": ["3", "2", "1", "via"] }, { "variabili": { "n": 1 }, "atteso": ["1", "via"] } ] },
    { "id": "p7", "titolo": "Le stelline", "capitolo": "Cicli", "sintassi": ["call", "let", "if", "for", "while"], "consegna": "Scrivi una riga con n asterischi: le stringhe si attaccano con +. Parti da una stringa vuota \"\".", "starter": "let riga = \"\"\n", "esempio": { "n": 3 }, "casi": [ { "variabili": { "n": 3 }, "atteso": ["***"] }, { "variabili": { "n": 1 }, "atteso": ["*"] }, { "variabili": { "n": 5 }, "atteso": ["*****"] } ] },
    { "id": "p8", "titolo": "Multipli di 3", "capitolo": "Cicli", "sintassi": ["call", "let", "if", "for", "while"], "consegna": "Scrivi solo i multipli di 3 tra 1 e n (compreso).", "starter": "", "esempio": { "n": 10 }, "casi": [ { "variabili": { "n": 10 }, "atteso": ["3", "6", "9"] }, { "variabili": { "n": 3 }, "atteso": ["3"] }, { "variabili": { "n": 2 }, "atteso": [] } ] },
    { "id": "p9", "titolo": "Quante cifre", "capitolo": "Cicli", "sintassi": ["call", "let", "if", "for", "while"], "consegna": "Scrivi quante cifre ha n (n è maggiore di 0). Dividere per 10 con Math.floor(n / 10) toglie l'ultima cifra.", "starter": "let cifre = 0\n", "esempio": { "n": 123 }, "casi": [ { "variabili": { "n": 123 }, "atteso": ["3"] }, { "variabili": { "n": 7 }, "atteso": ["1"] }, { "variabili": { "n": 1000 }, "atteso": ["4"] } ] },
    { "id": "p10", "titolo": "FizzBuzz", "capitolo": "Cicli", "sintassi": ["call", "let", "if", "for", "while"], "consegna": "Per i numeri da 1 a n: scrivi \"Fizz\" se è multiplo di 3, \"Buzz\" se è multiplo di 5, \"FizzBuzz\" se di entrambi, altrimenti il numero. Il classico dei colloqui di lavoro.", "starter": "for (let i = 1; i <= n; i++) {\n  \n}\n", "esempio": { "n": 5 }, "casi": [ { "variabili": { "n": 5 }, "atteso": ["1", "2", "Fizz", "4", "Buzz"] }, { "variabili": { "n": 15 }, "atteso": ["1", "2", "Fizz", "4", "Buzz", "Fizz", "7", "8", "Fizz", "Buzz", "11", "Fizz", "13", "14", "FizzBuzz"] } ] }
  ]
}
